{
  "name": "waste-management",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @wm/resident && npm run build -w @wm/collector && npm run build -w @wm/recycler && npm run build -w @wm/admin",
    "dev": "npm run dev",
    "dev:resident": "npm run dev -w @wm/resident",
    "dev:collector": "npm run dev -w @wm/collector",
    "dev:recycler": "npm run dev -w @wm/recycler",
    "dev:admin": "npm run dev -w @wm/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "generate:ws": "node scripts/generate-ws.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.6.3"
  }
}
