# Example environment configuration for Waste Management Platform

# Database URL (SQLAlchemy async DSN) — SQLite for podman (no postgres)
DATABASE_URL=sqlite+aiosqlite:////app/data/waste.db
# Example for local PostgreSQL (optional): postgresql+asyncpg://waste_user:waste_pass@localhost:5432/waste_management

# JWT configuration
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Upload directory inside the container
UPLOAD_DIR=/app/uploads

# PostgreSQL credentials (used by podman-compose)
POSTGRES_DB=waste_management
POSTGRES_USER=waste_user
POSTGRES_PASSWORD=waste_pass
