# Example environment configuration for Waste Management Platform

# Database URL (SQLAlchemy async DSN)
# Host venv (start.sh): sqlite+aiosqlite:///./test.db
# Podman backend (podman-compose.yml): sqlite+aiosqlite:////app/data/waste.db
DATABASE_URL=sqlite+aiosqlite:///./test.db

# JWT configuration
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Upload directory inside the container
UPLOAD_DIR=/app/uploads

# Frontend API URL — empty = same-port proxy (vite on :5173 → :8000, caddy on :8080)
# For ngrok: VITE_API_URL=https://xxx.ngrok-free.app   (then: VITE_API_URL=https://xxx.ngrok-free.app ./start.sh)
VITE_API_URL=

# PostgreSQL credentials (used only for --postgres manual fallback; podman now sqlite-only)
POSTGRES_DB=waste_management
POSTGRES_USER=waste_user
POSTGRES_PASSWORD=waste_pass
